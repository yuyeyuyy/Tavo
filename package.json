{
  "name": "tavo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @tavo/desktop dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && backend/.venv/bin/ruff check backend && backend/.venv/bin/ruff format --check backend",
    "test": "pnpm test:client && pnpm test:backend",
    "build": "pnpm --filter @tavo/desktop build",
    "test:e2e": "pnpm build && playwright test",
    "package:dir": "pnpm build && pnpm --filter @tavo/desktop package:dir",
    "test:packaged": "TAVO_PACKAGED=1 playwright test",
    "test:dev": "node scripts/dev-smoke.mjs",
    "dev:backend": "cd backend && uv run python -m app.cli serve",
    "backend:init": "cd backend && uv sync --frozen && uv run python -m app.cli init",
    "test:client": "vitest run",
    "test:backend": "cd backend && .venv/bin/python -m pytest -q",
    "api:generate": "cd backend && .venv/bin/python -m app.export_openapi && cd .. && openapi-typescript backend/openapi.json -o apps/desktop/src/renderer/api/generated.ts",
    "test:docker": "node scripts/docker-smoke.mjs",
    "test:backend:smoke": "node scripts/backend-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.11.1",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.8",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "@tavo/shared": "workspace:*",
    "openapi-typescript": "7.13.0",
    "swagger-ui-dist": "5.34.1"
  }
}
