{
  "name": "tavo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm native:electron && pnpm --filter @tavo/desktop dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm native:node && vitest run",
    "build": "pnpm --filter @tavo/desktop build",
    "native:node": "node scripts/check-native.cjs",
    "native:electron": "node scripts/check-native.cjs --electron",
    "test:e2e": "pnpm build && pnpm native:electron && playwright test",
    "package:dir": "pnpm build && pnpm --filter @tavo/desktop package:dir",
    "test:packaged": "TAVO_PACKAGED=1 playwright test",
    "test:dev": "node scripts/dev-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.11.1",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.8",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "@tavo/shared": "workspace:*",
    "@tavo/core": "workspace:*",
    "@tavo/connectors": "workspace:*",
    "@tavo/agent": "workspace:*",
    "@tavo/storage": "workspace:*",
    "better-sqlite3": "13.0.3",
    "@langchain/langgraph": "1.7.3"
  }
}
