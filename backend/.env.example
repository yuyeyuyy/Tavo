# Values are loaded from the process environment; this file is not auto-loaded.
TAVO_DATA_DIR=.local
# Keep these external key files private (directory 0700, files 0600).
TAVO_KEYRING_FILE=.local/master.keys
TAVO_CLIENT_TOKEN_FILE=.local/client.token
TAVO_CORS_ORIGINS=tavo://app,http://localhost:5173,http://127.0.0.1:5173
TAVO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
TAVO_WORKER=1
# Optional one-time legacy model import source; defaults to TAVO_DATA_DIR/models.json.
# After 0004 initialization, SQLite is authoritative; configure new models in the client.
# TAVO_LLM_CONFIG_FILE=/absolute/path/models.json
# Model keys use the client encrypted submission form or hidden server model-key CLI.
# Never put keys in this example, ordinary configuration or command arguments.

# Model HTTP retries: initial attempt + at most 3 retries, within existing 30/60s deadlines.
# Restart the backend after changing environment variables; this file is not auto-loaded.
TAVO_MODEL_MAX_RETRIES=3
# Only supported DeepSeek models can grow an exhausted empty-response budget.
# This is a per-attempt ceiling, not a rewrite of stored model profile defaults.
TAVO_MODEL_RETRY_MAX_OUTPUT_TOKENS=16384
TAVO_MODEL_RETRY_DELAY_SECONDS=0.25
TAVO_MODEL_RETRY_MAX_DELAY_SECONDS=5

# Host Python Worker + prepared local Docker image; set 0 to disable administratively.
TAVO_BASH_ENABLED=1
TAVO_BASH_IMAGE=tavo-bash:dev-v3

# Optional administrator-owned sandbox policy (no keys). Relative to the backend cwd.
# Defaults: proxy + public HTTPS, no separate HTTP write approval for new permission modes.
# Set network.mode="none" to disable egress; legacy sessions keep their frozen restrictions.
# TAVO_SANDBOX_CONFIG=/absolute/path/sandbox.toml

# Real backend-host Bash is available by default to NEW dual-scope conversations.
# Administrative kill switch; this is independent of the Docker sandbox switch.
TAVO_HOST_BASH_ENABLED=1
