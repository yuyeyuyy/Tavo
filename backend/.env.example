# Values are loaded from the process environment; this file is not auto-loaded.
TAVO_DATA_DIR=.local
# Keep these external key files private (directory 0700, files 0600).
TAVO_KEYRING_FILE=.local/master.keys
TAVO_CLIENT_TOKEN_FILE=.local/client.token
TAVO_CORS_ORIGINS=tavo://app,http://localhost:5173,http://127.0.0.1:5173
TAVO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
TAVO_WORKER=1
# No real provider keys or model API keys are needed.
